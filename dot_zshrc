# DuckDB shortcuts
alias duck="duckdb"

# Query CSV with DuckDB
duckcsv() {
  if [[ -z "$1" ]]; then
    echo "Usage: duckcsv <file.csv> [query]"
    echo "Example: duckcsv data.csv \"SELECT * FROM - LIMIT 10\""
    return 1
  fi
  local file="$1"
  local query="${2:-SELECT * FROM '$file' LIMIT 10}"
  duckdb -c "$query"
}

